# Environment Configuration
# Copy this file to .env and fill in your values

# Google Gemini API (free tier - get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (Gmail - use App Password, not your real password)
# Create app password: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password_here

# LinkedIn Credentials (for automated login)
LINKEDIN_EMAIL=your_linkedin_email
LINKEDIN_PASSWORD=your_linkedin_password

# Indeed Account (optional)
INDEED_EMAIL=
INDEED_PASSWORD=

# Application Settings
MAX_APPLICATIONS_PER_HOUR=10
DRY_RUN=true
REVIEW_MODE=true
HEADLESS_BROWSER=false

# Job Search Defaults
JOB_TITLE=Software Engineer
JOB_LOCATION=Remote
EXPERIENCE_LEVEL=mid
SALARY_MIN=0

# Dashboard
DASHBOARD_PORT=5000
DASHBOARD_SECRET_KEY=change-this-to-a-random-string
